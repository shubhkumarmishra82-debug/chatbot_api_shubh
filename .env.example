# --- Database (auto-set if you attach Vercel Postgres in the Storage tab) ---
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# --- Search (Google Custom Search JSON API) -- optional ---
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_search_engine_id

# --- AI fallback: YOUR OWN self-hosted model server -- optional ---
# No vendor, no API key from any company. Point this at a server you
# control that's running Ollama. See app/llm.py for full setup notes.
OWN_SERVER_URL=https://your-own-server.example.com
OWN_SERVER_MODEL=llama3.1
OWN_SERVER_TOKEN=only_if_you_added_your_own_auth

# --- Branding ---
APP_NAME=GMS Chatbot
CREATOR_NAME=Shubh
