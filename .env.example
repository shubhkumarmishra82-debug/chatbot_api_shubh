# --- Database (auto-set if you attach Vercel Postgres in the Storage tab) ---
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# --- Search (Google Custom Search JSON API) -- optional ---
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_search_engine_id

# --- AI: your own self-hosted server ONLY -- no vendor key, ever ---
# Leave these unset and the bot still works fine using custom replies,
# your documents, and search. Set them once you've got your own server
# (see oracle_setup.sh) running Ollama.
# OWN_SERVER_URL=http://your-server-ip:8443
# OWN_SERVER_MODEL=llama3.1
# OWN_SERVER_TOKEN=only_if_you_added_your_own_auth

# --- Branding ---
APP_NAME=GMS Chatbot
CREATOR_NAME=Shubh
